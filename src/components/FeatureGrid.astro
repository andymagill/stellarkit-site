---
export interface Feature {
  title: string;
  description: string;
}

interface Props {
  features?: Feature[];
}

const {
  features = [
    {
      title: "Static First",
      description: "Pre-rendered HTML for optimal performance and SEO",
    },
    {
      title: "Flexible Styling",
      description: "Full control over your brand identity with custom CSS",
    },
    {
      title: "Built for Conversion",
      description: "Analytics, forms, and tracking built into the foundation",
    },
  ],
} = Astro.props;
---

<section class="py-16 px-8 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-4xl font-bold text-center mb-12 text-[var(--color-text)]">Why StellarKit?</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-8">
      {features.map((feature) => (
        <div class="bg-white p-8 rounded-xl shadow-sm transition-transform hover:-translate-y-1 hover:shadow-lg">
          <h3 class="text-2xl font-semibold mb-4 text-[var(--color-brand)]">{feature.title}</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

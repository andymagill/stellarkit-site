---
interface Props {
  headline?: string;
  subheadline?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  headline = "Build Amazing Marketing Sites",
  subheadline = "Powered by StellarKit — the foundation for high-converting pages",
  ctaText = "Get Started",
  ctaLink = "#"
} = Astro.props;
---

<section class="py-24 px-8 bg-[linear-gradient(135deg,var(--color-brand)_0%,var(--color-brand-dark)_100%)] text-white text-center">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-[clamp(2rem,5vw,4rem)] font-bold mb-4 leading-tight">{headline}</h1>
    <p class="text-[clamp(1rem,3vw,1.5rem)] mb-8 opacity-95">{subheadline}</p>
    <a href={ctaLink} class="inline-block px-10 py-4 bg-white text-[var(--color-brand)] rounded-lg font-semibold no-underline transition-transform hover:-translate-y-0.5 hover:shadow-xl">{ctaText}</a>
  </div>
</section>

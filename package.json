    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.2.0",
    "typescript-eslint": "^8.56.0"
